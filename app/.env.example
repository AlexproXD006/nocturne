# Nocturne build-time settings. Real .env files are git-ignored; this file is the template.
#
# NOTE: the Vite root of this project is src/renderer, so Vite looks for env files
# there. Either copy this file to src/renderer/.env, or export the variable in your
# shell for a single build:
#     VITE_DEFAULT_SERVER=https://music.example.com npm run build

# Pre-fills the "Server address" field on the sign-in screen. That is ALL it does:
# the user can change it, nothing is sent to it before they submit the form, and it
# is not a secret (it ends up in the public JS bundle). Leave it empty to ship a
# build with a blank field.
# Example: VITE_DEFAULT_SERVER=https://music.example.com
VITE_DEFAULT_SERVER=

# Project URL sent to LRCLIB in the `Lrclib-Client` identification header (they ask
# clients to identify themselves). Point it at your fork or site. Optional.
# VITE_PROJECT_URL=https://github.com/<you>/nocturne

# --- Android (read by scripts/patch-android.mjs / Gradle, NOT by Vite) -------------
# Release signing. Set all four to produce a signed `assembleRelease` APK.
# NOCTURNE_KEYSTORE must be an absolute path.
# NOCTURNE_KEYSTORE=/home/you/keys/nocturne.jks
# NOCTURNE_KEYSTORE_PASSWORD=
# NOCTURNE_KEY_ALIAS=nocturne
# NOCTURNE_KEY_PASSWORD=

# Development only: allow plain-http access to these LAN hosts from the Android app
# (also relaxes WebView mixed-content blocking for that build). Never ship a release with this.
# NOCTURNE_LAN_HOSTS=192.168.1.50,nas.local

# Development only: enable chrome://inspect on the Android WebView.
# NOCTURNE_DEBUG_WEBVIEW=1

# Override the Android versionCode (defaults to major*1e6 + minor*1e3 + patch).
# NOCTURNE_VERSION_CODE=1000000
