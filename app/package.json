{
  "name": "nocturne",
  "productName": "Nocturne",
  "version": "1.1.0-beta.2",
  "description": "A clean, lightweight music player for your own music server. No ads, no clutter.",
  "main": "./out/main/index.js",
  "author": "Alex",
  "license": "MIT",
  "homepage": "https://github.com/AlexproXD006/nocturne",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "mock": "node mock-server/server.mjs",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "build:hosted": "vite build --config vite.web.config.ts --mode hosted",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run test:coverage && npm run build && npm run build:web",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "android:add": "npm run build:web && cap add android && node scripts/patch-android.mjs",
    "android:sync": "npm run build:web && cap sync android && node scripts/patch-android.mjs",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "ios:icons": "node scripts/ios-icons.mjs",
    "ios:sync": "npm run build:web && cap sync ios",
    "ios:open": "cap open ios",
    "ios:altstore": "node scripts/altstore-source.mjs",
    "icons": "node scripts/make-icons.mjs",
    "validate:builder": "node scripts/validate-builder-config.mjs",
    "test:scripts": "node --test scripts/patch-android.test.mjs scripts/altstore-source.test.mjs",
    "kit": "npm run build:hosted && node scripts/make-server-kit.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^31.0.0",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.4",
    "typescript": "5.9",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
