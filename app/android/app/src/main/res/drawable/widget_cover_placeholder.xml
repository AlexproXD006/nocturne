<?xml version="1.0" encoding="utf-8"?>
<!-- Cover shown until the real artwork is loaded. Shapes plus a referenced drawable only (RemoteViews-safe). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33808CA8" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item
        android:width="28dp"
        android:height="28dp"
        android:drawable="@drawable/ic_widget_note"
        android:gravity="center" />
</layer-list>
