<?xml version="1.0" encoding="utf-8"?>
<!-- Large widget (4x4): big cover, title/artist, controls, current lyric line, next three songs. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_r2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/w_cover"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:src="@drawable/widget_cover_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/w_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/w_progress"
                android:indeterminate="false"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:max="1000"
                    android:progressDrawable="@drawable/widget_progress_light" />

                <ProgressBar
                    android:id="@+id/w_progress_dark"
                android:indeterminate="false"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="-4dp"
                    android:max="1000"
                    android:progressDrawable="@drawable/widget_progress_dark"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/w_prev"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_widget_prev" />

                    <ImageView
                        android:id="@+id/w_play"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_widget_play" />

                    <ImageView
                        android:id="@+id/w_next"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_widget_next" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/w_like"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_widget_heart" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/w_lyric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:maxLines="2"
            android:minLines="2"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_queue_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_q1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_q2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_q3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
