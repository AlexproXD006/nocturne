<?xml version="1.0" encoding="utf-8"?>
<!-- Small widget when it is resized narrower than 2 cells: cover and play/pause. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_r2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="4dp">

        <ImageView
            android:id="@+id/w_cover"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_cover_placeholder" />

        <ImageView
            android:id="@+id/w_play"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_play" />
    </LinearLayout>
</FrameLayout>
