<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/cfg_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_config_title"
            android:textColor="#eef2fa"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/widget_config_preview"
            android:textColor="#a9b4c9"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/cfg_preview_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#161c2b"
            android:padding="12dp">

            <FrameLayout
                android:id="@+id/cfg_preview"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/widget_config_colors"
            android:textColor="#a9b4c9"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/cfg_modes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/cfg_mode_adaptive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/widget_mode_adaptive"
                android:textColor="#eef2fa" />

            <RadioButton
                android:id="@+id/cfg_mode_material"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/widget_mode_material"
                android:textColor="#eef2fa" />

            <RadioButton
                android:id="@+id/cfg_mode_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/widget_mode_theme"
                android:textColor="#eef2fa" />

            <RadioButton
                android:id="@+id/cfg_mode_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/widget_mode_custom"
                android:textColor="#eef2fa" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/cfg_theme_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/widget_config_theme"
                android:textColor="#a9b4c9"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/cfg_theme"
                android:layout_width="match_parent"
                android:layout_height="48dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cfg_custom_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/cfg_swatches"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <EditText
                android:id="@+id/cfg_hex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:digits="#0123456789abcdefABCDEF"
                android:hint="@string/widget_config_hex"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions|textCapCharacters"
                android:maxLength="7"
                android:minHeight="48dp"
                android:textColor="#eef2fa"
                android:textColorHint="#74809a" />
        </LinearLayout>

        <TextView
            android:id="@+id/cfg_transparency_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#a9b4c9"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/cfg_transparency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:max="100" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/widget_config_radius"
            android:textColor="#a9b4c9"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/cfg_radius"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/widget_config_contrast_note"
            android:textColor="#74809a"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cfg_cancel"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/widget_config_cancel"
                android:textColor="#a9b4c9" />

            <Button
                android:id="@+id/cfg_save"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/widget_config_save"
                android:textColor="#8fb4ff"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
