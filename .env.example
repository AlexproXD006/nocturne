# ─────────────────────────────────────────────────────────────────────────────
# Nocturne server configuration.  cp .env.example .env  and edit.
# The real .env is git-ignored. Never commit secrets.
# Used both by docker compose (variable substitution in docker-compose.yml)
# and as the container's environment (env_file).
# ─────────────────────────────────────────────────────────────────────────────

# ── Docker compose only (not read by the server) ─────────────────────────────
# Host folder with your music (mounted at /music inside the container).
MUSIC_PATH=./music
# Host port to publish.
NOCTURNE_PORT=8000
# Prebuilt image to run instead of building locally, e.g.
# NOCTURNE_IMAGE=ghcr.io/alexproxd006/nocturne:latest

# ── Required secrets ─────────────────────────────────────────────────────────
# At least 32 characters each and DIFFERENT from each other. Generate with:
#   openssl rand -hex 32
# Changing NOCTURNE_JWT_SECRET signs everybody out; changing NOCTURNE_MEDIA_SECRET
# invalidates already issued stream/artwork URLs.
# The server refuses to start while these are empty.
NOCTURNE_JWT_SECRET=
NOCTURNE_MEDIA_SECRET=

# ── First admin account ──────────────────────────────────────────────────────
# Created on startup ONLY if no account exists yet (password: 10+ characters).
# Remove both lines after the first sign-in. Alternatively:
#   docker compose exec nocturne python -m nocturne_api.cli create-admin <user> <password>
NOCTURNE_ADMIN_USER=admin
NOCTURNE_ADMIN_PASS=

# ── Public address ───────────────────────────────────────────────────────────
# Exactly what browsers/apps use to reach the server (no trailing slash). Used for
# absolute artwork/stream URLs, the CSRF origin check and the cookie Secure flag
# (https:// → Secure cookies). Set it to your real address, e.g. https://music.example.com
NOCTURNE_PUBLIC_URL=http://localhost:8000

# Origins allowed to call /v1 cross-origin (comma separated). The hosted web app is
# same-origin and needs no entry. Default:
#   app://nocturne,https://localhost,capacitor://localhost,http://localhost:5173
# (desktop app, Android app, Vite dev server)
# NOCTURNE_CORS_ORIGINS=app://nocturne,https://localhost,capacitor://localhost

# Reverse proxy IPs whose X-Forwarded-For header is trusted for rate limiting
# (comma separated). Empty = trust none. With Docker this is usually the proxy
# container's IP on the shared network, e.g. 172.18.0.2.
# NOCTURNE_TRUSTED_PROXIES=

# Send Strict-Transport-Security on web responses (default: true). Browsers ignore
# it over plain http; set false if you never want HSTS (e.g. LAN-only, no TLS).
NOCTURNE_HSTS=true

# ── Downloads from Spotify / YouTube (optional) ──────────────────────────────
# Spotify API app credentials for spotdl/spotipy metadata (search, playlists).
# Create one at https://developer.spotify.com/dashboard. YouTube works without.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
# /v1/info only advertises Spotify as a source to the apps when these aliases are
# set too, so use the same values here.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Audio format for new downloads: opus (default), mp3, m4a, flac or wav.
# AUDIO_FORMAT=opus

# ── Lyrics generation (optional) ─────────────────────────────────────────────
# Ollama server used to time plain lyrics with an LLM. Default
# http://localhost:11434; if nothing answers there the step is skipped.
# From inside Docker, the host is usually http://host.docker.internal:11434
# (add `extra_hosts: ["host.docker.internal:host-gateway"]` on Linux).
# OLLAMA_BASE_URL=http://localhost:11434
# faster-whisper settings (only if the image was built with WITH_WHISPER=true).
# WHISPER_MODEL=small
# WHISPER_DEVICE=auto          # auto | cpu | cuda
# WHISPER_COMPUTE_TYPE=auto    # auto | int8 | float16 | ...

# ── App downloads / in-app updates from GitHub Releases ──────────────────────
# "owner/name" of the GitHub repository whose Releases provide the app downloads
# (/descargar/android, /descargar/windows, /descargar/linux, ... redirect to the
# release assets) and the in-app update feed /v1/updates/*. Queried with the
# public, unauthenticated GitHub API (cached 10 min; no token needed).
# Set it EMPTY to disable GitHub and serve only the local files + latest.json
# from NOCTURNE_DOWNLOADS_DIR. Default: AlexproXD006/nocturne
# NOCTURNE_RELEASES_REPO=AlexproXD006/nocturne

# ── Limits ───────────────────────────────────────────────────────────────────
# Maximum size of one uploaded file in MB (default 200).
# NOCTURNE_UPLOAD_MAX_MB=200

# ── Paths (the Docker image already sets these; change only for bare-metal) ─
# MUSIC_DIR=/music                              # image: /music   (code default ./music)
# NOCTURNE_DB_PATH=/music/nocturne.db           # default <MUSIC_DIR>/nocturne.db
# NOCTURNE_DATA_DIR=/music/.nocturne_data       # default <MUSIC_DIR>/.nocturne_data (art cache)
# NOCTURNE_WEB_DIR=/app/web                     # hosted SPA; code default /opt/nocturne/web
# NOCTURNE_DOWNLOADS_DIR=/downloads             # APK/zip/descargar.html + latest.json update feed;
#                                               # code default /opt/nocturne/downloads

# ── Legacy NOVA API ──────────────────────────────────────────────────────────
# The old NOVA endpoints (/api/*, /ws/*) and /docs, /redoc, /openapi.json have NO
# authentication. off (default) = 404 for everyone; internal = loopback only;
# on = exposed (only behind a proxy that blocks them).
# NOVA_LEGACY_API=off

# ── Android release keystore backup (optional, admin only) ───────────────────
# Lets an admin download a zip backup of YOUR Android signing keystore from
# /v1/admin/signing/keystore. Only useful if you build and sign your own APKs;
# mount the keystore into the container read-only and point at it.
# NOCTURNE_ANDROID_KEYSTORE=/secrets/nocturne-release.keystore
# NOCTURNE_ANDROID_KEY_ALIAS=nocturne
# NOCTURNE_ANDROID_KEYSTORE_PASS=
# (Signing the APK itself happens at build time with NOCTURNE_KEYSTORE,
#  NOCTURNE_KEYSTORE_PASSWORD, NOCTURNE_KEY_ALIAS, NOCTURNE_KEY_PASSWORD;
#  see app/.env.example.)

# ── Read by the code but currently unused / development only ─────────────────
# NOCTURNE_MAX_JOBS=2          # reserved, not enforced yet
# NOVA_INTERNAL_PORT=8001      # reserved, not used yet
# PORT=8000                    # only for `python main.py` (dev auto-reload run)
# NOCTURNE_TESTING=1           # test suite only: relaxes secret checks. NEVER in production.
